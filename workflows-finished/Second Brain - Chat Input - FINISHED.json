    {
      "parameters": {
        "jsCode": "// One output item per uploaded file, each with its binary under 'data'\nconst out = [];\n$input.all().forEach((item, idx) => {\n  const text = (item.json.chatInput ?? '').toString().trim();\n  const binary = item.binary || {};\n  for (const key of Object.keys(binary)) {\n    const b = binary[key];\n    out.push({\n      json: { file_name: b.fileName || key, file_type: b.mimeType || '', chat_text: text },\n      binary: { data: b },\n      pairedItem: { item: idx }\n    });\n  }\n});\nreturn out;"
      },
