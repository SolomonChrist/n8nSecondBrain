    {
      "parameters": {
        "jsCode": "const rows = $('Build File Rows').all().map(r => r.json);\nconst lines = rows.map(r => r.file_url ? `- [${r.title}](${r.file_url})` : `- ${r.title}`).join('\\n');\nconst count = rows.length === 1 ? '1 file' : `${rows.length} files`;\nreturn [{ json: { output: `✅ Saved ${count} to Google Drive and your Second Brain:\\n${lines}` } }];"
      },
