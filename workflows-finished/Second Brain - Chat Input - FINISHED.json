    {
      "parameters": {
        "jsCode": "const files = $('Split Files').all();\nconst captured = DateTime.now().setZone('America/Toronto').toFormat('yyyy-MM-dd HH:mm');\nreturn $input.all().map((u, i) => {\n  const f = files[i].json;\n  return { json: {\n    id: `M-${$execution.id}-${i + 1}`,\n    captured_at: captured,\n    type: 'file',\n    title: f.file_name,\n    note: f.chat_text || `Uploaded file: ${f.file_name}`,\n    status: 'new',\n    source: 'chat',\n    file_url: u.json.webViewLink || '',\n    file_type: f.file_type\n  }, pairedItem: { item: i } };\n});"
      },
