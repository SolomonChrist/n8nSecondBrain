      "parameters": {
        "httpMethod": "POST",
        "path": "second-brain-capture-7f3a9c2e41d86b05",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {
          "onlyRunIf": "={{ ['website_capture', 'webhook_test_ping'].includes($json.body?.event) }}"
        }
      },
      "id": "bf9ebcb9-ab8d-4218-bef3-ac5333d57670",
      "name": "Chrome Capture Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        448,
        464
      ],
      "webhookId": "1abe9cd7-4780-4a8f-bd48-65236c1be57d",
      "credentials": {
        "httpHeaderAuth": {
          "id": null,
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Key check: a wrong or missing key stops the run, so nothing is written\nconst KEY = 'YOUR_KEY';\nif ((input.headers || {})['x-second-brain-key'] !== KEY) {\n  throw new Error('Unauthorized: wrong or missing X-Second-Brain-Key header');\n}\n\nconst clean = (v) => (v === undefined || v === null ? '' : String(v).trim());\nconst body = input.body || {};\nif (body.event !== 'website_capture') return [{ json: { is_capture: false } }];\n\nconst page = body.page || {};\nconst meta = body.meta || {};\nconst og = body.openGraph || {};\nconst tags = Array.isArray(body.userTags) ? body.userTags.map(clean).filter(Boolean) : [];\nconst title = clean(page.title) || clean(og.title) || clean(page.url) || 'Untitled page';\n\n// Readable note: only what the user wrote or highlighted\nconst parts = [];\nif (clean(body.userNotes)) parts.push(clean(body.userNotes));\nif (clean(body.selectedText)) parts.push(`Highlighted: ${clean(body.selectedText)}`);\nif (tags.length) parts.push(`Tags: ${tags.join(', ')}`);\nconst note = parts.join('\\n\\n') || `Saved page: ${title}`;\n\n// Full payload for later review, kept under the 50,000 character cell limit\nlet raw = JSON.stringify(body);\nif (raw.length > 49000) {\n  const { structuredData, ...rest } = body;\n  raw = JSON.stringify({ ...rest, meta: { ...meta, allMetaTags: {} }, rawTruncated: true });\n  if (raw.length > 49000) raw = raw.slice(0, 49000);\n}\n\nreturn [{ json: {\n  is_capture: true,\n  id: `M-${$execution.id}`,\n  captured_at: DateTime.now().setZone('America/Toronto').toFormat('yyyy-MM-dd HH:mm'),\n  type: 'web',\n  title: title.slice(0, 200),\n  note,\n  status: 'new',\n  source: 'chrome',\n  file_url: clean(page.url),\n  file_type: 'webpage',\n  short_summary: (clean(meta.description) || clean(og.description)).slice(0, 500),\n  raw_json: raw\n} }];"
      },
